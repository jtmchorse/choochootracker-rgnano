# ChooChooTracker key map for fkgpiod (loaded by choochootracker.sh, restored on exit).
# Every button is a plain key with no FN combos, so Select (wired to the FN line)
# arrives as KEY_K and Select+direction reaches the app as two keys.
# System functions move to MENU combos; the tracker never uses MENU.
# fkgpiod emits only the matching combo (members are subtracted from the mask).
CLEAR
MAP UP       TO KEY     KEY_U
MAP DOWN     TO KEY     KEY_D
MAP LEFT     TO KEY     KEY_L
MAP RIGHT    TO KEY     KEY_R
MAP A        TO KEY     KEY_A
MAP B        TO KEY     KEY_B
MAP X        TO KEY     KEY_X
MAP Y        TO KEY     KEY_Y
MAP L        TO KEY     KEY_M
MAP R        TO KEY     KEY_N
MAP START    TO KEY     KEY_S
MAP FN       TO KEY     KEY_K
MAP MENU     TO KEY     KEY_Q
MAP MENU+UP  TO COMMAND snapshot
MAP MENU+A   TO COMMAND volume up
MAP MENU+Y   TO COMMAND volume down
MAP MENU+X   TO COMMAND brightness up
MAP MENU+B   TO COMMAND brightness down
